# MongoDB
MONGO_URI=mongodb://user:pass@host:27017/uza?authSource=admin
# Pool / timeout tuning (remote Mongo — reduces burst load and long hangs)
MONGO_MAX_POOL_SIZE=15
MONGO_MIN_POOL_SIZE=2
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
MONGO_CONNECT_TIMEOUT_MS=10000
MONGO_SOCKET_TIMEOUT_MS=45000
MONGO_HEARTBEAT_FREQUENCY_MS=10000
MONGO_MAX_IDLE_TIME_MS=60000
MONGO_RECONNECT_DELAY_MS=3000
EXCHANGE_RATE_CACHE_TTL_MS=120000
CATEGORY_THUMBNAIL_CONCURRENCY=4
CATEGORY_THUMBNAIL_TIMEOUT_MS=4000
PORT=1302

# 1688 Open Platform (products / suppliers / trade / logistics)
ALIBABA_BASE_APP_URL=http://gw.open.1688.com/openapi/
ALIBABA_APP_KEY=
ALIBABA_APP_SECRET=
ALIBABA_AUTH_TOKEN=

# Trade relay — creates 1688 cross-border orders on UZA checkout
ALIBABA_TRADE_ENABLED=true
ALIBABA_TRADE_FLOW=general
ALIBABA_TRADE_ISV_BIZ_TYPE=cross

# China consolidation warehouse address (1688 ships here first)
ALIBABA_TRADE_WAREHOUSE_PROVINCE=浙江省
ALIBABA_TRADE_WAREHOUSE_CITY=杭州市
ALIBABA_TRADE_WAREHOUSE_AREA=滨江区
ALIBABA_TRADE_WAREHOUSE_ADDRESS=网商路699号
ALIBABA_TRADE_WAREHOUSE_CONTACT=UZA Bulk Warehouse
ALIBABA_TRADE_WAREHOUSE_MOBILE=13800000000
ALIBABA_TRADE_WAREHOUSE_DISTRICT_CODE=330108

# OAuth (optional — auto-refresh token instead of manual ALIBABA_AUTH_TOKEN)
ALIBABA_OAUTH_ENABLED=false
ALIBABA_OAUTH_REDIRECT_URI=https://your-api.example.com/api/v1/alibaba/oauth/callback

# Background jobs
ALIBABA_LOGISTICS_JOB_ENABLED=true
ALIBABA_LOGISTICS_POLL_HOURS=6
ALIBABA_CATALOG_SYNC_JOB_ENABLED=true
ALIBABA_CATALOG_SYNC_INTERVAL_HOURS=24

# Elasticsearch product index — incremental sync after 1688 catalog updates
ES_PRODUCT_SYNC_JOB_ENABLED=true
# Optional periodic catch-up (0 = off; sync still runs after catalog job)
ES_PRODUCT_SYNC_INTERVAL_HOURS=0

# Alibaba Cloud Model Studio (DashScope) — OpenAI-compatible LLM API
# Get API key: Model Studio console → API Key management
# Workspace ID = owner account / workspace id shown in console (Singapore/HK/Frankfurt regions)
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
# singapore | us | beijing | hongkong | frankfurt | singapore_workspace
DASHSCOPE_REGION=singapore
# International Singapore (typical for sk- keys from Model Studio):
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# Workspace MaaS URL only if shown in your console:
# DASHSCOPE_BASE_URL=https://YOUR_WORKSPACE_ID.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# Use qwen-vl-plus if qwen-plus is not authorized in Model Studio console
DASHSCOPE_MODEL=qwen-vl-plus
DASHSCOPE_VL_MODEL=qwen-vl-plus
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3
DASHSCOPE_EMBEDDING_DIMENSIONS=1024
DASHSCOPE_TIMEOUT_MS=60000
# Auto-apply AI without frontend (default: true when API key is set)
DASHSCOPE_AUTO_SMART_LISTING=true
DASHSCOPE_AUTO_RECOMMENDATIONS=true
DASHSCOPE_RECOMMENDATION_BOOST_WEIGHT=4
DASHSCOPE_AI_SEARCH=true
DASHSCOPE_AI_TEXT_SEARCH=true
DASHSCOPE_AI_IMAGE_SEARCH=true
DASHSCOPE_SMART_IMAGE_SEARCH=true
# Buyer-side vector search tuning
SEARCH_EMBEDDING_BOOST=true
VECTOR_SEARCH_CANDIDATE_LIMIT=800
CNY_PER_USD=7.2
# Async WAN image enhancement (background catalog upgrade)
DASHSCOPE_WAN_ENHANCE=false

# Personalized Recommendations Engine (Behavioral AI)
RECOMMENDATION_ENGINE_ENABLED=true
RECOMMENDATION_CACHE_TTL_MS=900000
RECOMMENDATION_CROSS_SELL_TTL_MS=300000
RECOMMENDATION_EMAIL_TTL_MS=604800000
RECOMMENDATION_AB_TEST=true
RECOMMENDATION_AB_TREATMENT_RATIO=0.5
DASHSCOPE_RANKING_MODEL=qwen-turbo
ROCKETMQ_ENABLED=false
ROCKETMQ_WEBHOOK_URL=

# =============================================================================
# AI Buyer Assistant (RAG chatbot on storefront)
# Floating chat widget → POST /api/v1/buyer-assistant/chat
# Retrieves context from: catalog products, cart, orders, FAQs, trade policies,
# and current page (pathname / productId / orderId), then answers via DashScope LLM.
# Requires DASHSCOPE_API_KEY (see DashScope section above).
# =============================================================================

# Master switch. false disables chat endpoints and returns BUYER_ASSISTANT_DISABLED.
BUYER_ASSISTANT_ENABLED=true

# Max context chunks merged into one LLM prompt per user message (after scoring/dedup).
# Each chunk is one slice of knowledge (e.g. one product, one order, one FAQ).
# Higher = richer answers for cart/order/policy questions; slightly more tokens/latency.
# Auto-boosted to 8–10 when an order or product search is detected.
# Range: typically 5–10. Default in code: 6.
BUYER_ASSISTANT_RAG_TOP_K=6

# Character limit per chunk text included in the LLM "Context:" block.
# Does not truncate DB retrieval — only what is sent to the model.
# Higher helps MOQ tiers, order line items, and long FAQ answers.
# Range: 250–1400. Default in code: 1000.
BUYER_ASSISTANT_CONTEXT_CHARS=1000

# Number of prior user/assistant turns replayed to the model (short-term memory).
# Helps follow-ups like "what about shipping on that order?" within the same session.
# Session also stores lastOrderRef / lastProductId / lastPageContext for vague follow-ups.
# Range: 2–12. Default in code: 8.
BUYER_ASSISTANT_HISTORY_MESSAGES=8

# Max tokens the LLM may generate for one reply (answer + SOURCES line).
# Higher allows longer order summaries and multi-product recommendations.
# Hard cap in code: 1000. Default in code: 800.
BUYER_ASSISTANT_MAX_TOKENS=800

# Performance vs depth trade-off during RAG retrieval (not the LLM model itself).
# true  = faster: fewer FAQs loaded (20), fewer product/policy chunks, shorter product-search timeouts.
# false = richer: more FAQs (40), +1 product chunk, +1 policy chunk — better for returns/shipping/MOQ questions.
# Default in code when unset: true. Recommended for production quality: false.
BUYER_ASSISTANT_FAST_MODE=false

# Whether to embed the user's message via DashScope before retrieval (for semantic scoring).
# Needed for vector product search and better FAQ/policy ranking.
# Set false only to save ~1 API call per message when DashScope is rate-limited.
BUYER_ASSISTANT_EMBEDDINGS=true

# Enable semantic vector product search inside chatbot RAG (requires embeddings + ES vector index).
# Finds catalog items by meaning ("red leather handbag") not just keyword match.
# Keep false unless product embeddings are built and VECTOR_SEARCH_CANDIDATE_LIMIT is tuned.
BUYER_ASSISTANT_VECTOR_SEARCH=false

# Max ES vector candidates when BUYER_ASSISTANT_VECTOR_SEARCH=true.
# Higher = broader semantic recall; more ES load. Range in code: up to 80. Default: 48.
# BUYER_ASSISTANT_VECTOR_CANDIDATES=48

# Max wait (ms) for message embedding before skipping vector/semantic scoring. Range: 1000–8000.
BUYER_ASSISTANT_EMBED_TIMEOUT_MS=3000

# Max wait (ms) for full RAG retrieval (orders, cart, products, FAQs). On timeout, falls back to static policies only.
# Range: 2000–15000. Increase if Mongo/ES is slow on remote hosts.
BUYER_ASSISTANT_RETRIEVAL_TIMEOUT_MS=6000

# When true, cart/product/empty-cart/order intents use pre-written HTML templates instead of LLM generation.
# Faster and more deterministic, but less conversational. false = always use RAG + LLM (recommended).
BUYER_ASSISTANT_USE_GROUNDED_TEMPLATES=false

# DashScope model for chat replies. Falls back to DASHSCOPE_FAST_MODEL → DASHSCOPE_RANKING_MODEL → qwen-turbo.
# qwen-plus: better reasoning for orders/policies. qwen-turbo: faster/cheaper.
DASHSCOPE_ASSISTANT_MODEL=qwen-plus

# Human escalation — shown in welcome messages, dispute replies, and WhatsApp action buttons.
# SUPPORT_WHATSAPP_DISPLAY=0788 371 081
# SUPPORT_WHATSAPP_URL=https://wa.me/250788371081

# =============================================================================
# Visual image search (pHash — compare uploaded photo vs catalog images)
# Requires: pip install -r scripts/requirements-image-search.txt (Python + OpenCV)
# Build index after deploy or catalog sync: npm run image-index:build
# =============================================================================
LOCAL_IMAGE_SEARCH_ENABLED=true
# Run live pHash scan per upload (uses prebuilt index under public/image-search/)
LOCAL_IMAGE_SEARCH_LIVE_ENABLED=true
# 0 = no limit when building index; set e.g. 5000 for partial dev builds
LOCAL_IMAGE_SEARCH_BUILD_LIMIT=0
# Gallery images per product indexed (more = better recall, larger index)
LOCAL_IMAGE_SEARCH_IMAGES_PER_PRODUCT=4
# Minimum pHash similarity (0–1) to count as a visual match
LOCAL_IMAGE_SEARCH_MIN_SIMILARITY=0.38
# Max catalog candidates scanned per live search request
LOCAL_IMAGE_SEARCH_LIVE_CANDIDATES=120

# =============================================================================
# Search / runtime policy
# Frontend-facing search and chat stay local-only (Elasticsearch + Mongo + embeddings).
# 1688 Open Platform code remains for back-office import, catalog sync, and trade relay — not live user search.
# =============================================================================

# When false (default): no live 1688 product refresh on PDP view or cart variation sync.
# When true: PDP/cart may call 1688 getProductDetail to refresh supplier data (admin/import use cases).
RUNTIME_SUPPLIER_SYNC_ENABLED=false

# Live ES phrase hints during image search (no offline vocabulary build)
CATALOG_VOCAB_LIVE_ENABLED=true
# Max extra keyword tokens added per image search from catalog vocabulary
CATALOG_VOCAB_LIVE_MAX_TOKENS=3

# Visual-first pipeline: prefer catalog photo matches; VL/embedding keywords only when visual hits are thin
IMAGE_SEARCH_VISUAL_FIRST=true
# Minimum visual matches before skipping keyword supplement
IMAGE_SEARCH_VISUAL_MIN_RESULTS=2
# Drop loosely related fill-in results (category-only or weak name overlap)
IMAGE_SEARCH_STRICT_RELEVANCE=true
# Min relevance score for keyword-supplement items (higher = stricter)
IMAGE_SEARCH_MIN_RELEVANCE_SCORE=14
# Max non-visual items appended after strong visual matches
IMAGE_SEARCH_MAX_SUPPLEMENT_ITEMS=8
# Expand visual search to full catalog ES query (heavier; usually leave false)
IMAGE_SEARCH_VISUAL_EXPAND_CATALOG=false
# Pull similar products from ES when visual set is small
IMAGE_SEARCH_VISUAL_EXPAND_SIMILAR=true
# Use embedding vector as primary ranking signal in image search
IMAGE_SEARCH_EMBEDDING_PRIMARY=true
# Use metadata/semantic rerank on image search candidates
IMAGE_SEARCH_METADATA_SEMANTIC=true


GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an authorized redirect URI in Google Cloud Console (API host + this path)
GOOGLE_REDIRECT_URI=http://localhost:1302/api/v1/users/auth/google/callback
# Storefront URL — Google OAuth redirects here with ?token= after login
FRONTEND_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000
# For Google One Tap: add the storefront origin(s) under Authorized JavaScript origins
# in Google Cloud Console (e.g. http://localhost:3000 and https://uzabulk.com).